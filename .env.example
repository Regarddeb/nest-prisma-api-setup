APP_NAME=API
APP_URL=http://localhost
APP_PORT=3000

NODE_ENV=development

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=test
DB_USERNAME=root
DB_PASSWORD=
DB_URL=mysql://root@127.0.0.1:3306/test

# Supabase project settings -> API. SUPABASE_JWT_SECRET is under
# Project Settings -> API -> JWT Settings ("legacy JWT secret").
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Rate limiting (ms window / max requests per window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated origins, or * for all
CORS_ORIGIN=*